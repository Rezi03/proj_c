<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VolForecast</RootNamespace>
    <AssemblyName>VolForecast</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Génération du PDF (licence Community gratuite pour un particulier) -->
    <PackageReference Include="QuestPDF" Version="2024.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bibliothèque C++ compilée par build.sh, copiée à côté de l'exécutable -->
    <None Include="../native/lib/*" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
